import TworowD4Kernel.Q597Cells

/-!
# Q597 (Hex) on the 144 exported clusters, in exact arithmetic

Paper claim: (Hex), `projects/proofs/2026-11-27c2-Q597-MC.tex`; Python check
`proofs/code-1127c2-Q597/hexenum.py` (float `φ`, `1e-9` tolerances). Every cluster
{rhombus, square, triangle, triangle} that the engine's acceptance test accepts (boundary with
6 turning corners, corner set invariant under the 180° (type a) or 120° (type b) rotation about
its centre) has: boundary = 6 unit edges; the rotation maps the whole boundary edge set to itself;
the hexagon is convex.

The data `clusters` is exported by `proofs/code-1128c2-Q597hex/hexexport.py`, which runs
`hexenum.py` unchanged and writes out exactly the clusters it accepts: per cluster, the four tiles
(ℤ⁴ vertex cycles), the boundary cycle (ℤ⁴) and the type. **This file does not trust the
exported boundary or any centre**: it recomputes the boundary from the tiles (edges used by exactly
one tile), recomputes `6c` as the sum of the six vertices, and decides every clause with
`Q597Cells.Phi` and the exact sign `Z3.sgn` (proved to be the real sign by `Z3.sgn_sound`).

What is checked is the conclusion of (Hex) **on this list**. That the list is the complete set of
accepted clusters is the Python enumeration's claim, not checked here (registry child node).

The rotation acts on ℤ⁴ (`hexenum.rotc` = `migrate.prot`, both factors by `ω₆`). The plane
statement follows from `Phi_add` and `Phi_rot60` below: `2·Φ(ρP) = (1 + i√3)·Φ(P)`, i.e. `Φ`
intertwines `ρ` with rotation by 60° in the plane.
-/

namespace Q597Hex

open Q597G1 Q597Cells

abbrev P4 := V × V

/-- `hexenum.prot` / `mosaic.protk` for one step: both factors multiplied by `ω₆`, `(a,b) ↦ (-b, a+b)`. -/
def rot60 (v : V) : V := (-v.2, v.1 + v.2)
def rot1 (P : P4) : P4 := (rot60 P.1, rot60 P.2)
def protk : ℕ → P4 → P4
  | 0, P => P
  | k + 1, P => rot1 (protk k P)

def smul4 (n : ℤ) (P : P4) : P4 := ((n * P.1.1, n * P.1.2), (n * P.2.1, n * P.2.2))

/-- Rotation by `60k°` about the centre `c`, in coordinates scaled by `6`: with `C6 = 6c`,
`6·rotc(P,c,k) = C6 + protk k (6P − C6)`. -/
def rotS (C6 : P4) (k : ℕ) (P6 : P4) : P4 := C6 + protk k (P6 - C6)

inductive Typ | a | b
  deriving DecidableEq, Repr

structure Cluster where
  typ : Typ
  tiles : List (List P4)
  cyc : List P4

/-- Consecutive pairs of a cyclic vertex list. -/
def cedges (c : List P4) : List (P4 × P4) := c.zip (c.rotate 1)

def sameEdge (e f : P4 × P4) : Bool := (e.1 == f.1 && e.2 == f.2) || (e.1 == f.2 && e.2 == f.1)

def memE (e : P4 × P4) (L : List (P4 × P4)) : Bool := L.any (sameEdge e)

/-- Boundary of a cluster: the tile edges used by exactly one tile. -/
def bdry (tiles : List (List P4)) : List (P4 × P4) :=
  let E := tiles.flatMap cedges
  E.filter fun e => E.countP (sameEdge e) = 1

/-- Clause 0: the tiles are 2 triangles and 2 quadrilaterals, and their boundary (recomputed)
is exactly the edge set of the 6-cycle `cyc`, whose vertices are distinct. -/
def bdryOK (C : Cluster) : Bool :=
  C.tiles.length == 4 && C.tiles.countP (·.length == 3) == 2 && C.tiles.countP (·.length == 4) == 2 &&
  C.cyc.length = 6 && C.cyc.Nodup && (bdry C.tiles).length = 6 &&
  (bdry C.tiles).all (memE · (cedges C.cyc)) && (cedges C.cyc).all (memE · (bdry C.tiles))

def norm2 (P : P4) : Z3 := inner (Phi P) (Phi P)

/-- Clause 1: every boundary edge is a unit edge, `|Φ(Q − P)|² = 16` (= `|φ|² = 1`). -/
def unitOK (C : Cluster) : Bool := (cedges C.cyc).all fun e => norm2 (e.2 - e.1) == ⟨16, 0⟩

/-- The sign of `v` relative to the directed edge `p → q`. -/
def side (p q v : P4) : ℤ := Z3.sgn (det (Phi (q - p)) (Phi (v - p)))

/-- Clause 2 (strict convexity): fix `s = ±1`; for every boundary edge `p → q`, every vertex off
the edge lies strictly on side `s`. This implies every turn has sign `s` (hexenum's test) and,
more, that the hexagon is the intersection of six open half-planes' closures, i.e. convex
and simple. -/
def convexOK (C : Cluster) : Bool :=
  [1, -1].any fun s => (cedges C.cyc).all fun e =>
    C.cyc.all fun v => v == e.1 || v == e.2 || side e.1 e.2 v == s

/-- `6c`, the scaled centre: the sum of the six vertices (all six are corners, by clause 2). -/
def C6 (C : Cluster) : P4 := C.cyc.foldr (· + ·) 0

def ks : Typ → List ℕ
  | .a => [3]
  | .b => [2, 4]

/-- Clause 3: for each rotation of the type, the scaled boundary edge set maps onto itself. -/
def rotOK (C : Cluster) : Bool :=
  let E6 := (cedges C.cyc).map fun e => (smul4 6 e.1, smul4 6 e.2)
  (ks C.typ).all fun k =>
    E6.all (fun e => memE (rotS (C6 C) k e.1, rotS (C6 C) k e.2) E6) &&
    E6.all (fun f => E6.any fun e => sameEdge (rotS (C6 C) k e.1, rotS (C6 C) k e.2) f)

def hexOK (C : Cluster) : Bool := bdryOK C && unitOK C && convexOK C && rotOK C

